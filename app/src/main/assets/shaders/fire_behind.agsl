uniform shader contourTable;
uniform float2 counts;
float4 flameGradient(float y,bool inner) {
    float4 a=inner?float4(1.,247./255.,160./255.,1.):float4(1.,176./255.,0.,1.);
    float4 b=inner?float4(1.,211./255.,36./255.,1.):float4(250./255.,90./255.,5./255.,1.);
    float4 c=inner?float4(1.,148./255.,0.,223./255.):float4(1.,51./255.,0.,184./255.);
    float4 d=inner?float4(1.,100./255.,0.,0.):float4(1.,48./255.,0.,0.);
    float first=inner?.25:.32,second=inner?.68:.7;
    if(y<first)return mix(a,b,clamp(y/first,0.,1.));
    if(y<second)return mix(b,c,(y-first)/(second-first));
    return mix(c,d,clamp((y-second)/(1.-second),0.,1.));
}
float4 flamePart(float2 p,float2 extent,float bend,float curl,bool inner,float alpha) {
    float2 q=p/extent;
    if(q.y < -1.-pixel/extent.y || q.y > pixel/extent.y)return float4(0.);
    float y=clamp(-q.y,0.,1.);
    float3 l=contourTable.eval(float2(y*255.+.5,.5)).rgb*float3(4.,2.,2.)-float3(2.,1.,1.);
    float3 r=contourTable.eval(float2(y*255.+.5,1.5)).rgb*float3(4.,2.,2.)-float3(2.,1.,1.);
    float left=l.x+l.y*bend+l.z*curl,right=r.x+r.y*bend+r.z*curl;
    float inside=min(min(q.x-left,right-q.x)*extent.x,min(-q.y,1.+q.y)*extent.y);
    float coverage=clamp(.5+inside/pixel,0.,1.);
    float4 color=flameGradient(y,inner);
    return ink(color.rgb,color.a*alpha,coverage);
}
float4 tongue(float2 p,int index) {
    float t=seconds,seed=phase;
    int top=int(counts.x),sideIndex=(index-top)/2;
    bool isTop=index<top,isLeft=index-top-sideIndex*2==0;
    float ph=isTop?seed+float(index)*2.39996:seed+float(sideIndex)*3.31+(isLeft?0.:2.);
    float angle=isTop?sin(t*2.+ph)*9.:(isLeft?-28.:28.);
    float radians=angle*.01745329252;
    float2 centre=isTop?float2(8.+(cardSize.x-16.)*(float(index)+.5)/counts.x,2.)
        :float2(isLeft?1.:cardSize.x-1.,13.+(cardSize.y-22.)*(float(sideIndex)+.5)/counts.y);
    float width=isTop?6.2+2.5*(.5+.5*sin(ph)):5.;
    float height=isTop?(10.+26.*(.5+.5*sin(ph*1.73)))*(.76+.24*sin(t*3.1+ph))
        :13.+11.*(.5+.5*sin(t*(isLeft?3.:2.7)+ph));
    float4 pose=float4(centre,cos(radians),sin(radians));
    float4 shape=float4(width,height,sin(t*3.7+ph)*.8,sin(t*5.1+ph*1.3)*.45);
    float2 delta=p-pose.xy;
    float2 local=float2(delta.x*pose.z+delta.y*pose.w,-delta.x*pose.w+delta.y*pose.z);
    if(abs(local.x)>shape.x*3.+pixel || local.y < -shape.y*1.12-pixel || local.y>pixel)return float4(0.);
    float4 result=flamePart(local,shape.xy*float2(1.35,1.12),shape.z,shape.w,false,40./255.);
    result=over(result,flamePart(local,shape.xy,shape.z,shape.w,false,225./255.));
    return over(result,flamePart(local,shape.xy*float2(.56,.72),shape.z,shape.w,true,225./255.));
}
half4 main(float2 p) {
    float interior=24.+pixel;
    if(p.x>interior &&p.x<cardSize.x-interior &&p.y>interior &&p.y<cardSize.y-interior)return half4(0.);
    float4 result=float4(0.);
    float pulse=.9+.1*sin(seconds*2.4+phase);
    float sd=roundDistance(p,cardSize*.5,cardSize*.5+1.,11.);
    for(int i=9;i>=1;i--) {
        float alpha=floor((9.+(9.-float(i))*2.4)*pulse+.5)/255.;
        result=over(result,ink(float3(1.,82./255.,0.),alpha,cover(abs(sd)-float(i)*3.7*.5)));
    }
    int topCount=int(counts.x),sideCount=int(counts.y);
    int nearTop=int(floor((p.x-8.)*counts.x/(cardSize.x-16.)-.5));
    int nearSide=int(floor((p.y-13.)*counts.y/(cardSize.y-22.)-.5));
    for(int i=0;i<48;i++) {
        bool top=i<topCount &&p.y<8.+pixel &&abs(float(i-nearTop))<=3.;
        bool side=i>=topCount &&i<topCount+sideCount*2
            &&(p.x<25.+pixel ||p.x>cardSize.x-25.-pixel) &&abs(float((i-topCount)/2-nearSide))<=2.;
        if(top ||side)result=over(result,tongue(p,i));
    }
    for(int i=0;i<24;i++) {
        float life=fract(seconds*(.075+float(i-5*(i/5))*.014)+phase*.07+float(i)*.173);
        float along=fract(float(i)*.6180339+phase*.013+life*.12);
        int side=i-4*(i/4);float2 position;
        if(side==0)position=float2(8.+(cardSize.x-16.)*along,-5.-life*34.);
        else if(side==1)position=float2(cardSize.x+5.+life*34.,8.+(cardSize.y-16.)*along);
        else if(side==2)position=float2(cardSize.x-8.-(cardSize.x-16.)*along,cardSize.y+5.+life*30.);
        else position=float2(-5.-life*30.,cardSize.y-8.-(cardSize.y-16.)*along);
        float drift=sin(seconds*.9+float(i)*1.73)*(1.5+life*2.5);
        if(side==0 ||side==2)position.x+=drift;else position.y+=drift;
        float4 s=float4(position,.65+.6*(1.-life),floor(205.*sin(life*3.141592654)+.5));
        float2 d=p-s.xy;float radius=s.z;
        if(abs(d.x)>radius*3.4+pixel ||abs(d.y)>radius*3.4+pixel)continue;
        result=over(result,ink(float3(1.,74./255.,0.),floor(s.w/5.)/255.,cover(length(d)-radius*3.4)));
        result=over(result,ink(float3(1.,(196.+float(i-3*(i/3))*12.)/255.,48./255.),s.w/255.,cover(length(d)-radius)));
        if(i-3*(i/3)==0 &&s.w>24.) {
            float a=min(230.,s.w+25.)/255.;float3 rgb=float3(1.,237./255.,143./255.);
            result=over(result,ink(rgb,a,cover(rectangleDistance(d,float2(radius*2.6,.35)))));
            result=over(result,ink(rgb,a,cover(rectangleDistance(d,float2(.35,radius*2.6)))));
        }
    }
    return half4(result);
}
