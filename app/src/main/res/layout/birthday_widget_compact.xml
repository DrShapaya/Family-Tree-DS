<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/birthday_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/birthday_widget_description">

    <ImageView
        android:id="@+id/birthday_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:src="@drawable/birthday_widget_placeholder_background"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/birthday_widget_text_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="6dp"
        android:paddingEnd="76dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/birthday_widget_name"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:text="@string/birthday_widget_preview_person_name"
            android:textColor="#242529"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/birthday_widget_countdown"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/birthday_widget_preview_subtitle"
            android:textColor="#555861"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/birthday_widget_photo"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/birthday_widget_photo_description"
        android:src="@drawable/birthday_widget_preview_celebration"
        android:scaleType="fitCenter" />
</FrameLayout>
